+def contour_to_polyboundary(points, is_open=False):
+    '''Turn a contour (a list of (x, y)) into the points of a <polyboundary>: up the left
+    side from the bottom, then down the right side. Coordinates are rounded to integers.
+
+    An open contour, which is how boundaries are normally drawn, is already in that order,
+    and is only reversed if it was drawn from the right. A closed contour may start at
+    any point and go either way round; it is started at the leftmost of the lowest points
+    and ended at the rightmost of them, leaving out the bottom edge between them.'''
+    pts = [(int(round(x)), int(round(y))) for x, y in points]
+    if is_open:
+        pts = [p for i, p in enumerate(pts) if i == 0 or p != pts[i - 1]]
+        if len(pts) < 2:
+            return None
+        if pts[0][0] > pts[-1][0]:
+            pts.reverse()
+        return pts
+    # drop repeated points, including the last if it closes onto the first
+    pts = [p for i, p in enumerate(pts) if p != pts[i - 1]] if len(pts) > 1 else pts
+    if len(pts) < 3:
+        return None
+    # signed area: positive is anticlockwise (y up). The left side goes up, so clockwise.
+    area = sum(x0 * y1 - x1 * y0 for (x0, y0), (x1, y1) in zip(pts, pts[1:] + pts[:1]))
+    if area > 0:
+        pts.reverse()
+    bottom = min(y for x, y in pts)
+    start = min((i for i, p in enumerate(pts) if p[1] == bottom), key=lambda i: pts[i][0])
+    pts = pts[start:] + pts[:start]
+    # the right side ends at the rightmost lowest point; take the first if several
+    lowest = [i for i, p in enumerate(pts) if p[1] == bottom and i > 0]
+    if lowest:
+        rightmost = max(pts[i][0] for i in lowest)
+        end = min(i for i in lowest if pts[i][0] == rightmost)
+        pts = pts[:end + 1]
+    return pts
 
