+class ast_PolyBoundary(ast.Expression):
+    """<polyboundary NULL> (points is None) or <polyboundary x y, x y, ...>"""
+    def __init__(self, points, location=None):
+        super(ast_PolyBoundary, self).__init__(location)
+        self.points = points
+
+    def asFea(self, indent=""):
+        if self.points is None:
+            return "<polyboundary NULL>"
+        return "<polyboundary " + ", ".join("{} {}".format(x, y) for x, y in self.points) + ">"
+
+class ast_PolyKernPosStatement(ast.Statement):
+    """pos polybase GLYPHS <polyboundary ...>; or pos polymark GLYPHS <polyboundary ...>;"""
+    def __init__(self, role, glyphs, boundary, location=None):
+        super(ast_PolyKernPosStatement, self).__init__(location)
+        self.role, self.glyphs, self.boundary = role, glyphs, boundary
+
+    def build(self, builder):
+        builder.add_polykern(self.location, self.role, self.glyphs.glyphSet(), self.boundary)
+
+    def asFea(self, indent=""):
+        return "pos {} {} {};".format(self.role, asFea(self.glyphs), self.boundary.asFea())
+
+class ast_PolyKernStatement(ast.Statement):
+    """polykern [@attached [@spaces]]; expanded into the PolyKern statements it generates."""
+    def __init__(self, statements, location=None):
+        super(ast_PolyKernStatement, self).__init__(location)
+        self.statements = statements
+
+    def build(self, builder):
+        for s in self.statements:
+            s.build(builder)
+
+    def asFea(self, indent=""):
+        return ("\n" + indent).join(s.asFea(indent=indent) for s in self.statements)
+
+class ast_ConditionsetStatement(ast.ConditionsetStatement):
+    """A condition set that may also hold lookup support tests: (table, type, format)."""
+    def __init__(self, name, conditions, lookuptests=(), location=None):
+        super(ast_ConditionsetStatement, self).__init__(name, conditions, location=location)
+        self.lookuptests = list(lookuptests)
+
+    def build(self, builder):
+        if self.lookuptests:
+            builder.add_conditionset(self.location, self.name, self.conditions, self.lookuptests)
+        else:
+            builder.add_conditionset(self.location, self.name, self.conditions)
+
+    def asFea(self, res="", indent=""):
+        res += indent + "conditionset {} ".format(self.name) + "{\n"
+        for tag, (minvalue, maxvalue) in self.conditions.items():
+            res += indent + SHIFT + "{} {} {};\n".format(tag, minvalue, maxvalue)
+        for table, lookupType, subtableFormat in self.lookuptests:
+            res += indent + SHIFT + "lookup {} {} {};\n".format(table, lookupType, subtableFormat)
+        res += indent + "}" + " {};\n".format(self.name)
+        return res
+
+class ast_VariationBlock(ast.VariationBlock):
+    """A variation block that may say replace (optionally naming lookups) or have an else
+    block (a FeatureBlock for the same feature)."""
+    def __init__(self, name, conditionset, use_extension=False, replace=False,
+                 replaceLookups=(), elseBlock=None, location=None):
+        super(ast_VariationBlock, self).__init__(name, conditionset, use_extension, location)
+        self.replace = replace
+        self.replaceLookups = list(replaceLookups)
+        self.elseBlock = elseBlock
+
+    def asFea(self, indent=""):
+        res = indent + "variation {} {} ".format(self.name.strip(), self.conditionset)
+        if self.replace:
+            res += " ".join(["replace"] + [l.name for l in self.replaceLookups]) + " "
+        if self.use_extension:
+            res += "useExtension "
+        res += "{\n" + ast.Block.asFea(self, indent=indent) + indent + "} "
+        if self.elseBlock is not None:
+            res += "else {\n" + ast.Block.asFea(self.elseBlock, indent=indent) + indent + "} "
+        res += "{};\n".format(self.name.strip())
+        return res
+
+class ast_PolyKernLookupsStatement(ast.Statement):
+    """polykernlookups FEATURE POLYKERNLOOKUP { fallback ... };
+    Expands to the PolyKern condition set (the first time) and a variation block that uses
+    the PolyKern lookup when the engine supports it, and the fallback otherwise."""
+    def __init__(self, conditionset, variation, location=None):
+        super(ast_PolyKernLookupsStatement, self).__init__(location)
+        self.conditionset = conditionset    # None if an earlier statement wrote it
+        self.variation = variation
+
+    def build(self, builder):
+        if self.conditionset is not None:
+            self.conditionset.build(builder)
+        self.variation.build(builder)
+
+    def asFea(self, indent=""):
+        res = ""
+        if self.conditionset is not None:
+            res += self.conditionset.asFea(indent=indent) + "\n"
+        return res + self.variation.asFea(indent=indent)
