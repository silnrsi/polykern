+                raise FeatureLibError(
+                    "Expected glyph class definition or statement: got {} {}".format(
+                        self.cur_token_type_, self.cur_token_),
+                    self.cur_token_location_)
+
+        self.expect_symbol_("}")
+        for symtab in self.symbol_tables_:
+            symtab.exit_scope()
+        if closing:
+            self.parse_block_closing_(block)
+
+    def parsePolyKern_(self):
+        """polykern [@attached [@spaces]];  NULL in place of a class means work it out.
+        Generates the pos polybase and pos polymark statements for the PolyKern lookup:
+          - attached (pos polymark): glyphs with an attachment point starting with _
+          - spaces (pos polybase, NULL boundary): other glyphs with no outline
+          - bases (pos polybase): other glyphs with a contour in the PolyKern layer
+        Boundaries come from the PolyKern layer of the UFO. Other glyphs are barriers."""
+        location = self.cur_token_location_
+        given = []
+        while self.next_token_ != ";":
+            if len(given) == 2:
+                raise FeatureLibError("polykern takes at most two glyph classes", location)
+            if self.next_token_ == "NULL":
+                self.expect_keyword_("NULL")
+                given.append(None)
+            else:
+                given.append(set(self.parse_glyphclass_(accept_glyphname=False).glyphSet()))
+        self.expect_symbol_(";")
+        given += [None] * (2 - len(given))
+
+        def info(name):
+            return self.glyphs.get(name) if hasattr(self.glyphs, 'get') else None
+
+        def boundary(name):
+            g = info(name)
+            return getattr(g, 'polyboundary', None) if g is not None else None
+
+        attached = given[0]
+        if attached is None:
+            attached = set(n for n in self.glyphs
+                           if any(a.startswith("_") for a in getattr(info(n), 'anchors', {})))
+        spaces = given[1]
+        if spaces is None:
+            spaces = set(n for n in self.glyphs if n not in attached
+                         and not getattr(info(n), 'has_outline', True))
+        statements = []
+        for n in self.glyphs:
+            if n in attached:
+                role = "polymark"
+            elif n in spaces:
+                if boundary(n) is not None:
+                    logging.warning("Space glyph %s has a contour in the PolyKern layer, "
+                                    "which is ignored", n)
+                statements.append(self.ast.PolyKernPosStatement("polybase",
+                        self.ast.GlyphName(n), self.ast.PolyBoundary(None), location=location))
+                continue
+            elif boundary(n) is not None:
+                role = "polybase"
+            else:
+                continue
+            statements.append(self.ast.PolyKernPosStatement(role, self.ast.GlyphName(n),
+                    self.ast.PolyBoundary(boundary(n)), location=location))
+        return self.ast.PolyKernStatement(statements, location=location)
+
+    def parsePolyKernLookups_(self):
+        """polykernlookups TAG POLYKERNLOOKUP { fallback statements };
+        Writes the PolyKern support condition set (the first time) and
+            variation TAG PolyKernSupported { lookup POLYKERNLOOKUP; } else { ... } TAG;
+        so that the fallback statements are used by engines without PolyKern."""
+        location = self.cur_token_location_
+        tag = self.expect_tag_()
+        name = self.expect_name_()
+        lookup = self.lookups_.resolve(name)
+        if lookup is None:
+            raise FeatureLibError('Unknown lookup "{}"'.format(name), self.cur_token_location_)
+        elseBlock = self.ast.FeatureBlock(tag, location=location)
+        self.parse_block_(elseBlock, False, closing=False)
+        self.expect_symbol_(";")
+        conditionset = None
+        if not getattr(self, 'polykern_conditionset_', False):
+            conditionset = self.ast.ConditionsetStatement(astx.POLYKERN_CONDITIONSET, {},
+                    [astx.POLYKERN_LOOKUP_TEST], location=location)
+            self.polykern_conditionset_ = True
+        variation = self.ast.VariationBlock(tag, astx.POLYKERN_CONDITIONSET,
+                                            elseBlock=elseBlock, location=location)
+        variation.statements.append(self.ast.LookupReferenceStatement(lookup, location=location))
+        return self.ast.PolyKernLookupsStatement(conditionset, variation, location=location)
