diff --git a/tests/test_polykern.py b/tests/test_polykern.py
new file mode 100644
index 0000000..928f51e
--- /dev/null
+++ b/tests/test_polykern.py
@@ -0,0 +1,114 @@
+#!/usr/bin/python3
+'''Tests for the PolyKern syntax: passing it through, and generating it from the UFO with
+polykern and polykernlookups.'''
+
+import os
+import unittest
+from pathlib import Path
+
+import feaxlib
+from feaxlib import contour_to_polyboundary, POLYKERN_LAYER
+import ufoLib2
+
+
+def addPolyKernLayer(font):
+    '''Add a PolyKern layer to the test font: LtnSmA, LtnSmB and LtnSmC as bases, and
+    CombAcute as an attached glyph. LtnSmA and LtnSmB are closed contours that start at
+    different points and go both ways round. LtnSmC is an open contour, as boundaries are
+    normally drawn, but drawn from the right.'''
+    layer = font.newLayer(POLYKERN_LAYER)
+    shapes = {
+        # anticlockwise, starting top right
+        'LtnSmA': [(520, 560), (-20, 560), (-40, -20), (540, -20)],
+        # clockwise, starting bottom right, with a flat top
+        'LtnSmB': [(560, -20), (-20, -20), (-20, 760), (300, 780), (520, 780), (560, 300)],
+        # a mark above
+        'CombAcute': [(100, 600), (120, 800), (300, 800), (320, 600)],
+    }
+    for name, points in shapes.items():
+        glyph = layer.newGlyph(name)
+        pen = glyph.getPen()
+        pen.moveTo(points[0])
+        for p in points[1:]:
+            pen.lineTo(p)
+        pen.closePath()
+    glyph = layer.newGlyph('LtnSmC')
+    pen = glyph.getPointPen()
+    pen.beginPath()
+    for i, p in enumerate([(500, -20), (520, 300), (480, 560), (40, 560), (-20, 200), (0, -20)]):
+        pen.addPoint(p, segmentType='move' if i == 0 else 'line')
+    pen.endPath()
+
+
+class PolyKernTests(unittest.TestCase):
+
+    def setUp(self):
+        os.chdir('tests/data')
+        self.font = ufoLib2.Font.open('../font-psf-test/source/PsfTest-Regular.ufo')
+
+    def tearDown(self):
+        self.font.close()
+        os.chdir('../..')
+
+    def parse(self, basename):
+        feafont = feaxlib.Font()
+        feafont.readaps(self.font)
+        feafont.make_marks()
+        feafont.make_classes(None)
+        p = feaxlib.feaplus_parser(None, feafont.glyphs, feafont.fontinfo, feafont.kerns,
+                                   feafont.defines)
+        return p.parse(f'{basename}.feax').asFea().strip()
+
+    def check(self, basename):
+        actual = self.parse(basename)
+        expected = Path(f'{basename}.fea').read_text().strip()
+        if actual != expected:
+            Path(f'{basename}.actual.fea').write_text(actual + '\n')
+        assert actual == expected
+
+    def test_generate(self):
+        addPolyKernLayer(self.font)
+        self.check('polykern')
+
+    def test_passthrough(self):
+        self.check('polykernpass')
+
+    def test_passthrough_reparses(self):
+        '''The FEA written out reads back in to the same FEA.'''
+        first = self.parse('polykernpass')
+        Path('polykernpass.out.feax').write_text(first)
+        try:
+            again = self.parse('polykernpass.out')
+        finally:
+            os.unlink('polykernpass.out.feax')
+        assert again == first
+
+    def test_no_layer(self):
+        '''Without a PolyKern layer, only the attached glyphs and spaces are generated.'''
+        out = self.parse('polykern')
+        assert 'pos polybase LtnSmA' not in out
+        assert 'pos polymark CombAcute <polyboundary NULL>;' in out
+        assert 'pos polybase Space <polyboundary NULL>;' in out
+
+    def test_contour(self):
+        # anticlockwise square from the top right
+        assert contour_to_polyboundary([(100, 100), (0, 100), (0, 0), (100, 0)]) == \
+            [(0, 0), (0, 100), (100, 100), (100, 0)]
+        # clockwise from the bottom right, with points along the bottom left out
+        assert contour_to_polyboundary(
+            [(100, 0), (50, 0), (0, 0), (0, 50), (10, 100), (90, 100), (100, 50)]) == \
+            [(0, 0), (0, 50), (10, 100), (90, 100), (100, 50), (100, 0)]
+        # a closing point repeating the first is dropped; values are rounded
+        assert contour_to_polyboundary([(0.4, 0), (0, 10.6), (10, 11), (10, 0), (0, 0)]) == \
+            [(0, 0), (0, 11), (10, 11), (10, 0)]
+        assert contour_to_polyboundary([(0, 0), (1, 1)]) is None
+        # open contours are kept as drawn, reversed if drawn from the right
+        assert contour_to_polyboundary([(0, 0), (0, 100), (100, 100), (100, 0)], True) == \
+            [(0, 0), (0, 100), (100, 100), (100, 0)]
+        assert contour_to_polyboundary([(100, 0), (100, 100), (0, 100), (0, 0)], True) == \
+            [(0, 0), (0, 100), (100, 100), (100, 0)]
+        assert contour_to_polyboundary([(0, 0)], True) is None
+
+
+if __name__ == '__main__':
+    unittest.main()
